# King Express Bus — Backend (Python/FastAPI). Placeholders only; never commit secrets.
# Keep in sync with app/core/config.py Settings and docker-compose.production.yml.

# App
APP_NAME=King Express Bus API
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_ENV=local
APP_DEBUG=true

# MySQL — Laravel-style split fields (assembled into async SQLAlchemy URL in Settings)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_kingexpressbus
DB_USERNAME=root
DB_PASSWORD=

# Auth / JWT / signed URLs
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SUCCESS_URL_SIGNING_KEY=change-me-success-signing-key-min-32

# Cookie (set COOKIE_SECURE=true behind HTTPS in production)
COOKIE_NAME=keb_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — Next.js origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000

# Public site base (SePay callbacks + signed success URLs)
FRONTEND_BASE_URL=http://localhost:3000
SUCCESS_PATH_TEMPLATE=/dat-ve/thanh-cong/{booking}

# Uploads (mirrors Laravel storage/app/public initially)
UPLOAD_ROOT=./uploads

# SePay
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init

# Email (Gmail SMTP + MySQL mail_jobs queue)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=King Express Bus
ADMIN_NOTIFY_EMAIL=admin@example.com
MAIL_MAX_ATTEMPTS=3
# true = process one job in the same BackgroundTask after enqueue (local/dev)
# false = only scripts.mail_worker sends (production)
MAIL_QUEUE_INLINE=true
