# King Express Bus — Backend
# Copy to `.env` locally, or paste into Coolify → Environment Variables.
# Never commit real secrets.
#
# Coolify + docker-compose.production.yml:
#   - MySQL runs as compose service `mysql`
#   - compose forces DB_HOST=mysql (ignore localhost here on Coolify)
#   - set DB_PASSWORD + secrets below, then deploy

APP_NAME=King Express Bus API
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

# MySQL (same stack on Coolify; local: use 127.0.0.1 and your local user)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_kingexpressbus
DB_USERNAME=keb
DB_PASSWORD=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SUCCESS_URL_SIGNING_KEY=

COOKIE_NAME=keb_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=https://kingexpressbus.com,https://www.kingexpressbus.com,https://kingexpressbus-fe-nextjs.vercel.app
FRONTEND_BASE_URL=https://kingexpressbus.com
SUCCESS_PATH_TEMPLATE=/dat-ve/thanh-cong/{booking}

UPLOAD_ROOT=/data/uploads

SEPAY_ENVIRONMENT=production
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=
MAIL_FROM_NAME=King Express Bus
ADMIN_NOTIFY_EMAIL=
MAIL_MAX_ATTEMPTS=3
MAIL_QUEUE_INLINE=false
