# King Express Bus — Backend production env (Coolify)
# Copy into Coolify Environment Variables / .env. Leave secrets blank until set.
# DB_* usually come from Coolify MySQL link — keep empty if already linked.
# SERVICE_* are Coolify-managed; do not invent values.

SERVICE_URL_API=api-kingexpressbus.minhlong03.site
SERVICE_FQDN_API=

APP_NAME=King Express Bus API
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SUCCESS_URL_SIGNING_KEY=

COOKIE_NAME=keb_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=https://kingexpressbus.com,https://www.kingexpressbus.com,https://kingexpressbus-fe-nextjs.vercel.app
FRONTEND_BASE_URL=https://kingexpressbus.com
SUCCESS_PATH_TEMPLATE=/dat-ve/thanh-cong/{booking}

UPLOAD_ROOT=/data/uploads

SEPAY_ENVIRONMENT=production
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=
MAIL_FROM_NAME=King Express Bus
ADMIN_NOTIFY_EMAIL=
MAIL_MAX_ATTEMPTS=3
MAIL_QUEUE_INLINE=false
